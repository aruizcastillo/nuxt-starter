# Private Nuxt runtime overrides; Drizzle Kit reads NUXT_DATABASE_URL directly.
# Leave blank to work on the public shell. See README.md for each environment.
NUXT_DATABASE_URL=

# Better Auth
NUXT_BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_URL=

# Google OAuth
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# Planned Resend delivery (Phase 4). Set both or neither.
# Sender format: verified@example.com or App <verified@example.com>
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=
